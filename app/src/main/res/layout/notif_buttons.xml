<?xml version="1.0" encoding="utf-8"?>
<!-- Custom content for the persistent service notification: six one-tap shortcuts on TWO rows —
     row 1 (What's On, Door Cam, HA) + row 2 (Music, Conversations, Notifications). Two rows fit the
     COLLAPSED notification height, so the buttons show without expanding. Shown via
     DecoratedCustomViewStyle (the system draws the app-name header).

     Each button pins an explicit textSize + maxLines=1 + trimmed padding/minWidth. Without an explicit
     size the buttons inherited buttonBarButtonStyle's textAppearance, which a system/OEM update bumped
     larger — "What's On" then wrapped to two lines and pushed row 2 off the collapsed notification
     (truncated). The fixed small size keeps every label on one line and both rows visible. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_whatson"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="12sp"
            android:text="What's On"
            android:textColor="?android:attr/colorAccent"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_camera"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="12sp"
            android:text="Door Cam"
            android:textColor="?android:attr/colorAccent"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_ha"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="12sp"
            android:text="HA"
            android:textColor="?android:attr/colorAccent"
            android:textAllCaps="false" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_music"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="12sp"
            android:text="Music"
            android:textColor="?android:attr/colorAccent"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_conversations"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="12sp"
            android:text="Messages"
            android:textColor="?android:attr/colorAccent"
            android:textAllCaps="false" />

        <Button
            android:id="@+id/btn_notifications"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minWidth="0dp"
            android:paddingLeft="2dp"
            android:paddingRight="2dp"
            android:gravity="center"
            android:maxLines="1"
            android:textSize="12sp"
            android:text="Notifs"
            android:textColor="?android:attr/colorAccent"
            android:textAllCaps="false" />
    </LinearLayout>


    <!-- Full-width status row below the buttons: message (left, up to 4 lines) + Clear button (right).
         GONE unless a status message is set over MQTT (<base>/status); DashService toggles the row +
         text. The notification grows to fit only when there is a message. -->
    <LinearLayout
        android:id="@+id/notif_status_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:visibility="gone">

        <TextView
            android:id="@+id/notif_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="6dp"
            android:paddingTop="2dp"
            android:paddingBottom="6dp"
            android:maxLines="4"
            android:ellipsize="end"
            android:textSize="13sp"
            android:textColor="?android:attr/textColorPrimary" />

        <Button
            android:id="@+id/btn_status_clear"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Clear"
            android:textColor="?android:attr/colorAccent"
            android:textAllCaps="false" />
    </LinearLayout>

</LinearLayout>
