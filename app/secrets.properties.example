# Copy to app/secrets.properties (gitignored) and fill in. Values become BuildConfig fields.
broker_host=172.20.1.100
broker_port=1883
broker_user=ajith
broker_pass=CHANGEME
# Base MQTT topic. App subscribes <base>/show and <base>/dismiss,
# publishes <base>/cmd and <base>/request.
base_topic=lockdash
# Full RTSP URL (incl. credentials) for the default camera screen (the doorbell)
rtsp_url=rtsp://admin:CHANGEME@172.20.1.23:554/Preview_01_main
# Home Assistant URL for the Home Assistant WebView screen
ha_url=http://172.20.1.100:8123
# How long a dash screen stays before auto-closing (ms)
dismiss_ms=90000
